{
  "name": "@lista-acoes/backend",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS do gerenciador de ações",
  "scripts": {
    "dev": "nodemon --watch src --exec \"node -r @babel/register src/main.js\"",
    "build": "babel src -d dist --ignore \"src/**/*.test.js\"",
    "start": "node dist/main.js",
    "test": "jest",
    "db:migrate": "node -r @babel/register src/database/cli.js migrate",
    "db:status": "node -r @babel/register src/database/cli.js status",
    "db:admin": "node -r @babel/register src/database/cli.js admin"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.js",
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
