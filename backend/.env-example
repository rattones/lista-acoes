# Variáveis da API (backend).
# Copie para backend/.env e ajuste. O .env nunca é versionado.
# A API valida estas variáveis ao iniciar e não sobe se alguma obrigatória faltar.

# Ambiente de execução: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3000; em PROD o Nginx publica em api.listadecompras.net)
PORT=3000

# Nível de log (JSON): fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info

# OBRIGATÓRIA. Origens liberadas no CORS, separadas por vírgula.
# DEV: app em casa-ratton.local:8080 e casaratton.ddns.net:8080; PROD: https://app.listadecompras.net
CORS_ORIGENS=http://casa-ratton.local:8080,http://casaratton.ddns.net:8080

# Arquivo do banco SQLite, relativo à pasta backend/ (padrão: data/monitor.db).
# A pasta é criada se não existir. Nos containers, data/ é o volume persistente.
DB_ARQUIVO=data/monitor.db

# OBRIGATÓRIA. Segredo de assinatura dos tokens JWT (mínimo de 32 caracteres).
# Gere um por ambiente: openssl rand -base64 48
# Trocar o segredo encerra todas as sessões abertas.
JWT_SEGREDO=

# Cookie do refresh token com a flag Secure (só trafega em HTTPS).
# Padrão: true em production, false nos demais (o DEV é HTTP).
# COOKIE_SEGURO=false

# Quantos proxies confiáveis há na frente da API (o IP do cliente vem do X-Forwarded-For).
# Padrão 0 (acesso direto, DEV). PROD: 1 (Nginx), já definido no compose.
# CONFIAR_PROXY=0
