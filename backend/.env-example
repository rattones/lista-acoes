# Variáveis da API (backend).
# Copie para backend/.env e ajuste. O .env nunca é versionado.
# A API valida estas variáveis ao iniciar e não sobe se alguma obrigatória faltar.

# Ambiente de execução: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3000; em PROD o Nginx publica em api.listadecompras.net)
PORT=3000

# Nível de log (JSON): fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info

# OBRIGATÓRIA. Origens liberadas no CORS, separadas por vírgula.
# DEV: app em casa-ratton.local:8080 e casaratton.ddns.net:8080; PROD: https://app.listadecompras.net
CORS_ORIGENS=http://casa-ratton.local:8080,http://casaratton.ddns.net:8080

# Arquivo do banco SQLite, relativo à pasta backend/ (padrão: data/monitor.db).
# A pasta é criada se não existir. Nos containers, data/ é o volume persistente.
DB_ARQUIVO=data/monitor.db

# OBRIGATÓRIA. Segredo de assinatura dos tokens JWT (mínimo de 32 caracteres).
# Gere um por ambiente: openssl rand -base64 48
# Trocar o segredo encerra todas as sessões abertas.
JWT_SEGREDO=

# Cookie do refresh token com a flag Secure (só trafega em HTTPS).
# Padrão: true em production, false nos demais (o DEV é HTTP).
# COOKIE_SEGURO=false

# Quantos proxies confiáveis há na frente da API (o IP do cliente vem do X-Forwarded-For).
# Padrão 0 (acesso direto, DEV). PROD: 1 (Nginx), já definido no compose.
# CONFIAR_PROXY=0

# E-mail (Gmail SMTP com senha de app). Em produção, SMTP_USER, SMTP_PASS e MAIL_FROM são
# OBRIGATÓRIAS; fora dela, sem usuário e senha o envio fica desligado (erro tratável).
# Senha de app: conta Google com verificação em duas etapas → myaccount.google.com/apppasswords.
# Limite do Gmail: cerca de 500 destinatários por dia.
SMTP_HOST=smtp.gmail.com
# 465 = TLS direto; 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente (a própria conta Gmail ou um alias verificado nela)
MAIL_FROM="Lista de Ações <sua-conta@gmail.com>"

# Base dos links enviados por e-mail (convite, recuperação de senha).
# Padrão fora de produção: http://localhost:8080. Os composes já definem:
# DEV http://casaratton.ddns.net:8080; PROD https://app.listadecompras.net (VITE_APP_URL).
# APP_URL=http://localhost:8080

# Wrapper de dados de ativos (Yahoo Finance, Binance, CoinGecko). Todas opcionais.
# User-Agent das chamadas (o Yahoo recusa alguns agentes genéricos).
# WRAPPER_USER_AGENT="Mozilla/5.0 (compatible; lista-acoes/1.0; +https://www.listadecompras.net)"
# Tempo máximo de cada tentativa, em milissegundos
# WRAPPER_TIMEOUT_MS=8000
# Tentativas por chamada (backoff exponencial em erro de rede, 429 e 5xx), de 1 a 5
# WRAPPER_TENTATIVAS=3
# Cache em memória das respostas, em segundos (0 desliga)
# WRAPPER_CACHE_SEGUNDOS=60
