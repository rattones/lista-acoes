{
  "name": "@lista-acoes/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "App Vue e landing page do gerenciador de ações",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.js",
    "dev:landing": "vite --config vite.landing.config.js",
    "build": "npm run build:app && npm run build:landing",
    "build:app": "vite build --config vite.app.config.js",
    "build:landing": "vite build --config vite.landing.config.js",
    "preview": "vite preview --config vite.app.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.4"
  }
}
