# Variáveis do app e da landing page (frontend).
# Copie para frontend/.env e ajuste. O .env nunca é versionado.
# Variáveis com prefixo VITE_ ficam visíveis no navegador: nunca coloque segredos nelas.

# URL base da API (DEV: http://casa-ratton.local:3000; PROD: https://api.listadecompras.net)
VITE_API_URL=http://casa-ratton.local:3000

# URL do app usada no link "Acessar o app" da landing page
# (DEV: http://casa-ratton.local:8080; PROD: https://app.listadecompras.net — padrão se ausente)
VITE_APP_URL=http://casa-ratton.local:8080
