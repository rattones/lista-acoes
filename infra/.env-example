# Variáveis do docker-compose.prod.yml (tarefa 005).
# Copie para infra/.env e ajuste. O .env nunca é versionado.
# O Compose lê infra/.env sozinho (pasta do arquivo compose), mesmo rodando da raiz.

# Portas do proxy Nginx no host: HTTP (padrão: 80) e HTTPS (padrão: 443).
# Para testes locais com as portas ocupadas: 8088 e 8444
PROXY_PORTA=80
PROXY_PORTA_HTTPS=443

# Let's Encrypt (usadas por infra/scripts/certificado-inicial.sh na emissão inicial)
# E-mail para os avisos de vencimento e problemas na renovação (obrigatório)
LETSENCRYPT_EMAIL=
# 1 = ambiente de testes (certificado não confiável, sem limite de emissões): ensaie antes
LETSENCRYPT_STAGING=0

# Origens liberadas no CORS da API (padrão: https://app.listadecompras.net)
CORS_ORIGENS=https://app.listadecompras.net

# Embutidas no build do frontend: mudar exige `up --build`
# URL base da API usada pelo app (padrão: https://api.listadecompras.net)
VITE_API_URL=https://api.listadecompras.net
# Link "Acessar o app" da landing page (padrão: https://app.listadecompras.net)
VITE_APP_URL=https://app.listadecompras.net
# Landing page para onde o app leva depois da exclusão da conta (padrão: https://www.listadecompras.net)
VITE_LANDING_URL=https://www.listadecompras.net
