# Variáveis do docker-compose.prod.yml (tarefa 005).
# Copie para infra/.env e ajuste. O .env nunca é versionado.
# O Compose lê infra/.env sozinho (pasta do arquivo compose), mesmo rodando da raiz.

# Porta do proxy Nginx no host (padrão: 80). Para testes locais com a porta 80 ocupada: 8088
PROXY_PORTA=80

# Origens liberadas no CORS da API (padrão: https://app.listadecompras.net)
CORS_ORIGENS=https://app.listadecompras.net

# Embutidas no build do frontend: mudar exige `up --build`
# URL base da API usada pelo app (padrão: https://api.listadecompras.net)
VITE_API_URL=https://api.listadecompras.net
# Link "Acessar o app" da landing page (padrão: https://app.listadecompras.net)
VITE_APP_URL=https://app.listadecompras.net
