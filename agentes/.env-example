# Variáveis dos agentes coletores (tarefa 035).
# Copie para agentes/.env e ajuste. O .env nunca é versionado.
# Os agentes validam estas variáveis ao iniciar e não sobem se alguma obrigatória faltar.

# OBRIGATÓRIA. URL da API. Nos composes os agentes usam a rede interna do Docker:
# http://backend:3000 (o compose já define; sobrescreve este valor).
API_URL=http://backend:3000

# OBRIGATÓRIAS. API keys dos agentes (la_<prefixo>_<segredo>), geradas por um admin no app,
# em "API keys" (a chave completa só aparece uma vez). Escopos de cada uma:
#   API_KEY_PRECOS:   ativos:read, precos:read, precos:write
#   API_KEY_NOTICIAS: ativos:read, noticias:write
API_KEY_PRECOS=
API_KEY_NOTICIAS=

# Fuso dos horários e das datas (padrão: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Nível de log (JSON): fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info

# Horários das rodadas, em expressão cron no fuso TZ.
# Preços: todo dia às 19:30 (padrão). Notícias: todo dia às 12:00 (padrão).
CRON_PRECOS=30 19 * * *
CRON_NOTICIAS=0 12 * * *

# Tempo máximo de cada requisição à API, em milissegundos (padrão: 30000)
API_TIMEOUT_MS=30000
