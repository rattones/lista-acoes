{
  "name": "lista-acoes",
  "version": "0.0.0",
  "private": true,
  "description": "Gerenciador de ações: API, app e landing page",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test:estrutura && npm test --workspaces --if-present",
    "test:estrutura": "node --test infra/scripts/estrutura.test.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke:dev": "node --test infra/scripts/smoke-dev.mjs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7"
  }
}
